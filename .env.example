# Export these for pnpm dev/db:migrate/admin:create; the production Compose uses it directly.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://workspace:workspace_dev@localhost:55432/workspace
# Generate: openssl rand -base64 32. Never commit the resulting .env.
CREDENTIAL_MASTER_KEY=
ALLOWED_CIDRS=
DENIED_CIDRS=127.0.0.0/8,::1/128,169.254.0.0/16,fe80::/10,0.0.0.0/8,::/128
ALLOWED_PORTS=22
ALLOWED_DNS_SUFFIXES=
SESSION_GRACE_SECONDS=600
MAX_SSH_SESSIONS=32

# Per-user attempt rate; concurrent live sessions remain separately bounded.
SSH_ATTEMPTS_PER_MINUTE=120
