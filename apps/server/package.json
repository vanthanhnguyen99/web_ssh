    "@fastify/helmet": "^13.0.2",
    "socket.io": "^4.8.1",
    "ssh2": "^1.17.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "ipaddr.js": "^2.2.0",
    "zod": "^3.25.76"
